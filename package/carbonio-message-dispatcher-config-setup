if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

set -e

MAIN_SERVICE_NAME="carbonio-message-dispatcher"
DB_SERVICE_NAME="carbonio-message-dispatcher-db"
MONGOOSEIM_TOML="${MONGOOSEIM_TOML:-/etc/carbonio/message-dispatcher/mongooseim.toml}"
MONGOOSEIM_TOML_TEMPLATE="${MONGOOSEIM_TOML}.in"

if [[ ! -r "${MONGOOSEIM_TOML_TEMPLATE}" ]]; then
  echo "MongooseIM configuration template not found: ${MONGOOSEIM_TOML_TEMPLATE}"
  exit 1
fi

get_consul_kv() {
  KEY=$1
  CONSUL_VALUE=$(consul kv get "$KEY" || echo "")
}

# Substitute database password
get_consul_kv "${DB_SERVICE_NAME}/db-password" >/dev/null 2>&1; DB_PASSWORD=$CONSUL_VALUE
if [[ "$DB_PASSWORD" == "" ]]; then
  echo "Carbonio Message Dispatcher database password not found."
  echo "Please install carbonio-message-dispatcher-db and run carbonio-message-dispatcher-db-bootstrap command."
  exit 1
fi

# Substitute API username
get_consul_kv "${MAIN_SERVICE_NAME}/api/username" >/dev/null 2>&1; API_USERNAME=$CONSUL_VALUE
if [[ "$API_USERNAME" == "" ]]; then
  if ! consul kv put "${MAIN_SERVICE_NAME}/api/username" "${MAIN_SERVICE_NAME}"; then
    echo "Cannot put a key value pair in Consul"
    exit 1
  fi
  API_USERNAME="$MAIN_SERVICE_NAME"
fi

# Substitute API password
get_consul_kv "${MAIN_SERVICE_NAME}/api/password" >/dev/null 2>&1; API_PASSWORD=$CONSUL_VALUE
if [[ "$API_PASSWORD" == "" ]]; then
  if ! (openssl rand -hex 16 | tr -d '\n' | consul kv put "${MAIN_SERVICE_NAME}/api/password" -); then
    echo "Cannot put a key value pair in Consul"
    exit 1
  fi
  get_consul_kv "${MAIN_SERVICE_NAME}/api/password" >/dev/null 2>&1; API_PASSWORD=$CONSUL_VALUE
  if [[ "$API_PASSWORD" == "" ]]; then
    echo "Cannot get a key value pair in Consul"
    exit 1
  fi
fi

escape_toml_sed_replacement() {
  printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
    | sed 's/[\\&|]/\\&/g'
}

DB_PASSWORD=$(escape_toml_sed_replacement "$DB_PASSWORD")
API_USERNAME=$(escape_toml_sed_replacement "$API_USERNAME")
API_PASSWORD=$(escape_toml_sed_replacement "$API_PASSWORD")

TEMP_TOML=$(mktemp "${MONGOOSEIM_TOML}.tmp.XXXXXX")
trap 'rm -f "$TEMP_TOML"' EXIT
sed \
  -e "s|<db-password>|$DB_PASSWORD|" \
  -e "s|<api-username>|$API_USERNAME|" \
  -e "s|<api-password>|$API_PASSWORD|" \
  "${MONGOOSEIM_TOML_TEMPLATE}" > "${TEMP_TOML}"
chmod 644 "${TEMP_TOML}"
mv -f "${TEMP_TOML}" "${MONGOOSEIM_TOML}"
trap - EXIT
