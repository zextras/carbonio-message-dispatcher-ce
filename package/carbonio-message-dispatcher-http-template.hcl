// Generated by carbonio-message-dispatcher-hcl from the packaged template on every
// upgrade and setup: local edits to this file are overwritten.
// To change the values, set them in /etc/zextras/service-discover/carbonio-message-dispatcher-http.env
// (KEY=value lines; "carbonio-message-dispatcher-hcl show" lists keys and defaults),
// then run carbonio-message-dispatcher-setup.

services {
  check {
    http     = "http://127.78.0.10:10000/api/graphql"
    method   = "GET"
    timeout  = "{{ or (env "CHECK_TIMEOUT") "1s" }}"
    interval = "{{ or (env "CHECK_INTERVAL") "5s" }}"
  }

  connect {
    sidecar_service {
      proxy {
        local_service_address = "127.78.0.10"
        upstreams             = [
          {
            destination_name   = "carbonio-message-dispatcher-db"
            local_bind_address = "127.78.0.10"
            local_bind_port    = 20000
          }
        ]
      }
    }
  }

  name = "carbonio-message-dispatcher-http"
  port = 10000
}
